<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary brand color (Material Purple 500) -->
    <color name="primary_color">#6200EE</color> <!-- Use for app bars, buttons -->

    <!-- Variant of the primary color (Material Purple 700) -->
    <color name="primary_variant_color">#3700B3</color> <!-- Used in status bars or emphasis surfaces -->

    <!-- Text/icons that appear on top of primary color (should be light for dark backgrounds) -->
    <color name="on_primary_color">#FFFFFF</color> <!-- Use white for contrast on dark purple -->

    <!-- General app background (dark theme example) -->
    <color name="background_color">#121212</color> <!-- Used for app window background -->

    <!-- (Optional extras if expanding theme support) -->

    <!-- Secondary color (Material Teal 200) -->
    <color name="secondary_color">#03DAC6</color>

    <!-- Text/icons on secondary -->
    <color name="on_secondary_color">#000000</color>

    <!-- Surface background (e.g., cards, sheets) -->
    <color name="surface_color">#1E1E1E</color>

    <!-- Text/icons on surface -->
    <color name="on_surface_color">#FFFFFF</color>

    <color name="colorPrimary">@color/primary_color</color>
    <color name="colorOnPrimary">@color/on_primary_color</color>

</resources>
